# Stray manual backups — git history is the backup, don't commit copies of index.html
*backup*.html
*.bak

# Build artifacts and dependencies, none of which are committed, across the npm
# workspaces (web/, worker/) and the root. index.html/hub.html (web/) are still
# hand-maintained; as of Stage 2 they're published via CI-built web/dist/ (deploy.yml),
# not served directly from this branch.
node_modules/
dist/
playwright-report/
test-results/
*.tsbuildinfo

# Cloudflare Worker local dev/deploy cache (worker/) — never committed, machine-local.
.wrangler/
