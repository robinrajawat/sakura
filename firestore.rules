rules_version = '2';

// Firestore Security Rules for Sakura.
//
// This file is not auto-deployed — paste it into Firebase Console → Firestore Database → Rules
// → Publish. Keeping it in the repo is so the actual access-control model has a diff history,
// instead of living only as tribal knowledge in the console.
//
// Collections:
//   1. /users/{uid}/...     — cloud sync. Every synced document, template, and settings blob
//      lives under here. Most of this subtree stays owner-only; /users/{uid}/docs/{docId}
//      specifically also grants access to anyone listed in that one document's own sharedWith
//      map, at the role (viewer/editor) recorded there — see that match block below for why
//      this can't just be "owner or nothing" anymore now that sharing exists.
//   2. /profiles/{uid}      — one doc per account, owned and written only by that account.
//      Always readable by its own owner; readable by anyone else ONLY when visibility=="public"
//      — a private profile is invisible to every other account, not just "found but unreachable".
//      This is what lookup-by-email for sharing queries against (see index.html's profile/share
//      code), rather than a separate always-public email→uid directory, specifically so no one
//      can probe whether an email has an account at all unless that account opted in.
//   3. /notifications/{uid}/items/{id} — generic, reusable notification inbox (share invites
//      today, anything else later — see the bell icon in index.html). Owner-only, both ways:
//      no one can read another account's notifications, and nothing here is created directly
//      by a client write from a DIFFERENT account — see the comment on that match block for how
//      a share invite still reaches the right inbox despite that restriction.
//   4. /feedback/{id}       — anyone can file one (create-only for non-admins); a small admin
//      set can read/triage/delete (see submitFeedback/reportErrorAuto in index.html).
//   5. /admins/{uid}        — existence-only admin registry backing isFeedbackAdminAuth() below.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/docs/{docId} {
      // Shared-access model: the owner always has full access. Anyone else needs their uid
      // present in this specific document's own sharedWith map, with role=='editor' required
      // for write access (role=='viewer' or 'editor' both suffice for read). Each sharedWith
      // entry is an object ({role, email, displayName, sharedAt}), not a bare role string —
      // so who-has-access can be displayed later even if that person's own profile has since
      // gone private. sharedWith lives on the document itself (not a separate collection) so a
      // single read of the doc a person is already fetching also tells them their own access
      // level — no second round-trip.
      //
      // A second field, sharedWithUids, sits alongside sharedWith purely so this document can be
      // FOUND via a collectionGroup query in the first place (see findDocsSharedWithMe in
      // index.html) — a plain array of collaborator uids, kept in sync by grantDocumentAccess/
      // revokeDocumentAccess. sharedWith alone can't be queried this way: a query on
      // sharedWith.<uid>.role embeds the CALLING user's own uid into the field path itself, and
      // Firestore indexes a collectionGroup query by its exact literal field path — there's no
      // way to pre-create an index for a field path that only exists once a specific uid is
      // plugged in, so every different account's first attempt would hit an un-indexed query
      // and fail, forever, no matter how many times any ONE of those per-uid indexes gets
      // created via the Console. sharedWithUids has one static field name, so one
      // array-contains index (collection-group scope) covers every user permanently. No rules
      // change was needed for this field itself — the owner's write access below is already
      // unrestricted by field name.
      //
      // request.resource.data is used (not resource.data) for read/write's OWN check where
      // sharedWith is being evaluated against a write, per Firestore's rule for `create` (no
      // `resource` exists yet); for existing-document read/update, resource.data is what's
      // already stored, which is the correct thing to check against for an incoming reader/
      // editor that isn't touching sharedWith themselves.
      // 'sharedWith' in resource.data (existence check) rather than resource.data.sharedWith !=
      // null: a doc that's never been shared has no sharedWith field at all, not a null one, and
      // directly dereferencing an absent field throws an evaluation error rather than returning
      // null. For a single get() that just denies that one read, but for the collectionGroup
      // list query in findDocsSharedWithMe (index.html), an error evaluating the rule against
      // ANY one candidate document fails the ENTIRE query with "Missing or insufficient
      // permissions" — not merely excluding that document. Since most docs predate ever being
      // shared, the old `!= null` form broke every shared-docs query, not just direct reads.
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        ('sharedWith' in resource.data && request.auth.uid in resource.data.sharedWith.keys())
      );
      // Only the owner can create a new doc record under their own path — sharing only ever
      // grants access to a document the owner already created, never lets a collaborator mint
      // one that appears to live under someone else's account.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        ('sharedWith' in resource.data && request.auth.uid in resource.data.sharedWith.keys() && resource.data.sharedWith[request.auth.uid].role == 'editor')
      );
      // Only the owner can delete — an editor can change content, not make the document
      // disappear from the owner's account entirely.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /profiles/{uid} {
      // For `list` (the email-lookup query the share dialog runs), Firestore evaluates this
      // same condition against EACH candidate document individually via `resource` — so a
      // query for profiles where email==X is only ever allowed to actually return documents
      // that are the requester's own, or that already have visibility=='public'. A private
      // profile can never come back from that query, full stop — not filtered client-side,
      // actually inaccessible.
      allow get, list: if request.auth != null && (
        request.auth.uid == uid || resource.data.visibility == 'public'
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      // A share invite is written by the SENDER into the RECIPIENT's inbox — i.e. request.auth.uid
      // (sender) != uid (recipient) is the normal case here, not an attack. Shape-restricted
      // instead of identity-restricted: any signed-in account can create an item in anyone's
      // inbox, but only with this specific known shape (type/fromUid/fromEmail/docId/createdAt,
      // read defaulting false), so this can't be used to write arbitrary data into someone
      // else's account the way an unrestricted create could.
      allow create: if request.auth != null &&
        request.resource.data.type is string &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.createdAt is number &&
        request.resource.data.read == false &&
        request.resource.data.keys().hasOnly(['type','fromUid','fromEmail','fromDisplayName','docId','docTitle','role','createdAt','read']);
    }

    // App-wide admin check for /feedback triage. Hardcoded email kept as a bootstrap fallback (so
    // this account can never get locked out), ORed with a data-driven /admins/{uid} doc so
    // additional admins can be added/removed without a code + rules redeploy. See index.html's
    // isFeedbackAdmin/checkIsCollectionAdmin for the client-side mirror of this same check.
    function isFeedbackAdminAuth() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'robinsinghrajawat@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---------------------------------------------------------------------
    // Feedback & automatic error reports. Anyone (signed in or not, since an error can happen
    // before sign-in and feedback shouldn't require an account) can file one via create. Reading,
    // updating (status/priority/a private resolution note), and deleting are limited to
    // isFeedbackAdminAuth() — Robin, or anyone granted via /admins. Basic shape validation only on
    // create: a non-empty, size-capped message and a known kind, so this can't be used to dump
    // arbitrary large blobs.
    // ---------------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.kind in ['feedback', 'error']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 6000;
      allow read: if isFeedbackAdminAuth();
      allow update: if isFeedbackAdminAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolutionNote', 'priority']);
      allow delete: if isFeedbackAdminAuth();
    }

    // Existence-only admin registry — a doc at /admins/{uid} means that uid is an admin, checked
    // by isFeedbackAdminAuth() above. A user may only read their OWN doc (existence, no field
    // values needed), never list the collection, so this can't be used to enumerate who else is
    // an admin. No client write path at all — adding/removing an admin is a Firebase Console
    // action, the same trust tier as reviewing /feedback directly in the console.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }
  }
}

